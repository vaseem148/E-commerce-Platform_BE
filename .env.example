# Nexa Commerce API - environment configuration
# Copy this file to ".env" and adjust the values for your environment.

# Secret used to sign JWT access tokens. CHANGE THIS IN PRODUCTION.
SECRET_KEY=nexa-super-secret-change-me-in-production-0f4c1a9b7e2d

# JWT algorithm and access token lifetime (minutes). 60 * 24 * 7 = one week.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLAlchemy database URL. SQLite by default - no external service required.
DATABASE_URL=sqlite:///./nexa.db

# Comma separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application metadata
PROJECT_NAME=Nexa Commerce API
VERSION=1.0.0
DEBUG=true

# Seed the database with demo data on first boot.
AUTO_SEED=true

# Demo accounts created by the seeder.
ADMIN_EMAIL=admin@nexa.com
ADMIN_PASSWORD=Admin@123
DEMO_EMAIL=demo@nexa.com
DEMO_PASSWORD=Demo@123
